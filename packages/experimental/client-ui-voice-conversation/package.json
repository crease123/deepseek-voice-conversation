{
  "name": "@deepseek-ai/dsh-client-ui-voice-conversation",
  "description": "Optional continuous voice conversations using the current Session and its tools",
  "version": "0.3.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-voice-speech-doubao": "workspace:*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@testing-library/react": "^16.3.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.1",
    "@deepseek-ai/dsh-personal-agent": "workspace:*",
    "@deepseek-ai/dsh-api-settings-controller": "^0.2.2-rc.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crease123/voice-call.git",
    "directory": "packages/experimental/client-ui-voice-conversation"
  }
}
